  "cards": [
    {
      "dot": "cyan",
      "title": "Front-Door & Routing",
      "items": [
        "Vercel serves Vite React SPA and proxies /api/* directly to Render",
        "FastAPI enforces CORS, security headers, correlation IDs, and gzip compression"
      ]
    },
    {
      "dot": "rose",
      "title": "Zero-Trust Enforcement",
      "items": [
        "SQL Guard parses AST via sqlglot, disallowing nested queries, CTEs, and functions",
        "Column lineage rewrite binds output aliases (_c0, _c1) to enforce per-column policies",
        "Target adapters enforce read-only transactions across SQLite, MySQL, and PostgreSQL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Discovery & Governance",
      "items": [
        "Local stacked ML model (TF-IDF + GBDT) runs fully on-server without external egress",
        "Optional Gemini 2.5 Flash receives ONLY mathematical aggregates, never raw data",
        "Audit log enforces cryptographic SHA-256 hash chaining with SQLite trigger immutability"
      ]
    }
  ]
