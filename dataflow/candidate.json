  "cards": [
    {
      "dot": "rose",
      "title": "Strict Zero Retention Invariant",
      "items": [
        "Raw table samples are extracted in temporary memory buffers only (N=100 rows per table)",
        "The discovery loop explicitly deletes samples (del samples) before any network I/O",
        "Raw data values are never saved to disk, logged, or transmitted across any boundary"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sanitized Feature Boundary",
      "items": [
        "Feature extraction produces mathematical aggregates: lengths, entropy, regex match ratios",
        "Neither column values nor text samples cross into the ML pipeline or external Gemini endpoint",
        "The external Gemini prompt receives only structural schema metadata and aggregate ratios"
      ]
    },
    {
      "dot": "emerald",
      "title": "Upgrade-Only Monotonicity",
      "items": [
        "Decisions follow a strict sensitivity lattice: PUBLIC (0) < INTERNAL (1) < PII_MEDIUM (3) < PII_HIGH (4)",
        "Models can only raise protection levels (APPLIED); downgrades and shuffling are rejected (KEPT_RULE)",
        "Human review status (approved/rejected/overridden) permanently locks classification from model edits"
      ]
    }
  ]
