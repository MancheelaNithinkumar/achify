  "cards": [
    {
      "dot": "cyan",
      "title": "Strict Query Lineage",
      "items": [
        "SQL is parsed with sqlglot and rewritten with positional aliases (_c0, _c1) to bind lineage",
        "Sub-queries, CTEs, UNION, and SQL functions are rejected to prevent lineage obfuscation",
        "Inference attacks in WHERE/HAVING/GROUP BY are blocked unless columns are granted raw access"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cached & Read-Only Execution",
      "items": [
        "Target databases execute in enforced read-only mode (PRAGMA query_only=ON / SET TRANSACTION READ ONLY)",
        "LRU + TTL result cache keys on rewritten SQL; cache hit skips database I/O while re-enforcing masking and audit"
      ]
    },
    {
      "dot": "rose",
      "title": "Immutable Cryptographic Audit",
      "items": [
        "Every execution generates a monotonically increasing seq and cryptographic SHA-256 prev_hash chain",
        "SQLite triggers (audit_no_update, audit_no_delete) raise abort errors on any modification attempt"
      ]
    }
  ]
