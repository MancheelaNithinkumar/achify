  "cards": [
    {
      "dot": "cyan",
      "title": "Access & Session Control",
      "items": [
        "roles table defines named RBAC principals and JSON permissions",
        "users reference roles.name as a foreign key; sessions store SHA-256 token hashes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Model Discovery Schema",
      "items": [
        "classifications stores the effective category, sensitivity, and review status",
        "ai_classifications and ml_classifications maintain 1:1 foreign keys on classifications.id",
        "Rule, ML, and AI verdicts are kept distinct so human reviewers can trace provenance"
      ]
    },
    {
      "dot": "rose",
      "title": "Immutable Audit Ledger",
      "items": [
        "audit_events maintains sequential integers (seq) and SHA-256 hash chains (prev_hash, entry_hash)",
        "Database triggers prohibit UPDATE and DELETE, guaranteeing tamper-evident immutability"
      ]
    }
  ]
}