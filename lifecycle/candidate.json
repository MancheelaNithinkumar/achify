  "cards": [
    {
      "dot": "emerald",
      "title": "Monotonic Lattice Rule",
      "items": [
        "Classification upgrades require strict inequality in sensitivity rank: PUBLIC < INTERNAL < PII_MEDIUM < PII_HIGH",
        "A model predicting a lower sensitivity level is assigned KEPT_RULE; automatic downgrades are mathematically impossible",
        "Classifications that match the rule scanner yield AGREES, keeping the baseline rule intact"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reviewer Authority Lock",
      "items": [
        "Human actions (approved, rejected, overridden) transition the column out of pending",
        "Future scans encounter the HUMAN_REVIEWED guard, permanently shielding manual verdicts from model overrides"
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic Availability Guarantee",
      "items": [
        "If external Gemini or local ML models fail, encounter quota issues, or are unconfigured, state becomes AI_UNAVAILABLE / ML_UNAVAILABLE",
        "Scans complete gracefully, ensuring data protection operates without interruption"
      ]
    }
