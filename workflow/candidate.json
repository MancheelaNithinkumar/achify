  "cards": [
    {
      "dot": "cyan",
      "title": "Leakage-Free Name Grouping",
      "items": [
        "Synthetic corpus excludes column names present in the Saffron Bank evaluation set",
        "GroupShuffleSplit partitions by base column name: test columns use names never seen during training",
        "5-fold GroupKFold cross-validation generates out-of-fold probability vectors to prevent target leakage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stacked Calibration Architecture",
      "items": [
        "Level 1: Logistic regression on TF-IDF character n-grams (2 to 5 chars) over column names",
        "Level 2: HistGradientBoosting on sanitized numeric statistics concatenated with OOF name probabilities",
        "Isotonic regression calibrates class probabilities to minimize Expected Calibration Error (ECE)"
      ]
    },
    {
      "dot": "rose",
      "title": "Dual-Benchmark Verification",
      "items": [
        "Model must generalize to unseen synthetic column names and achieve high macro-F1 and low ECE",
        "Model is evaluated on real Saffron Bank tables against human-curated ground truth (saffron_labels.csv)",
        "Both models are benchmarked against the deterministic rule engine to ensure upgrade monotonicity"
      ]
    }
  ]
